#!/bin/sh
set -e

PATH="$PWD/node_modules/.bin:$PATH"

echo "Running typecheck..."
bun --cwd web run typecheck

echo "Running ESLint..."
bun --cwd web run lint:ci

echo "Checking formatting..."
bun --cwd web run format:ci

echo "Running tests..."
bun --cwd backend test

echo "Pre-push checks passed."