{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rss-ingestion-scheduler",
  "main": "src/scheduled-ingestion.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "services": [
    {
      "binding": "RSS_WEB",
      "service": "rss-web",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
